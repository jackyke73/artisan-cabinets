DATABASE_URL="file:./dev.db"

# Optional — enables the AI match fallback for ambiguous lines. Leave unset to
# run fully offline on deterministic matching only.
ANTHROPIC_API_KEY=""
# Override the fallback model (default: claude-haiku-4-5). Swap to claude-opus-4-8
# for maximum quality at higher cost.
# MATCH_LLM_MODEL="claude-haiku-4-5"
# Set to 1 to force the AI fallback off even when a key is present.
# MATCH_LLM_DISABLED=""

# Optional — set a shared password to require login for the whole app. Leave
# unset to keep the app open (fine for a single local machine).
APP_PASSWORD=""

# Production: encrypts stored QuickBooks tokens at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset in local dev (tokens are then stored plaintext).
APP_ENCRYPTION_KEY=""

# QuickBooks Online integration (Phase 3). Create an app at developer.intuit.com,
# add the redirect URI below to it, and paste the Client ID/Secret here.
# Start with the Development (sandbox) keys; switch QBO_ENV to "production" later.
QBO_ENV="sandbox"
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI="http://localhost:3000/api/qbo/callback"
